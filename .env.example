# NebulaStreams VPS configuration example.
# Copy to .env and fill real secrets on the server. Do not commit .env.

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
CACHE_DIR=./cache

# Required for production admin safety. Use a long unique value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Required for signed private stream URLs. Use a long random value.
STREAM_SOURCE_TOKEN_SECRET=

# Supporter codes + Ko-fi automation.
SUPPORTER_CODE_SECRET=
KOFI_WEBHOOK_TOKEN=
KOFI_SUPPORTER_CODE_MONTHS=1
KOFI_MIN_AMOUNT=1
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_MONTHLY_VARIANT_IDS=
LEMON_SQUEEZY_LIFETIME_VARIANT_IDS=
LEMON_SQUEEZY_PREMIUM_VARIANT_IDS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NebulaStreams <support@your-domain.example>"
SUPPORTER_EMAIL_REPLY_TO=

# Optional, but recommended if you operate your own TMDB key.
TMDB_API_KEY=

# Optional Redis cache. Leave blank to use disk/memory cache.
REDIS_URL=
REDIS_CACHE_PREFIX=nebulastreams

# Optional reverse proxy and status integrations.
STATUS_PAGE_URL=
UPTIME_KUMA_TARGET=
REVERSE_PROXY_TARGET=
REVERSE_PROXY_TIMEOUT_SECONDS=120
REVERSE_PROXY_REJECT_UNAUTHORIZED=true

# VPS-friendly memory/concurrency defaults. Tune upward only after observing logs.
STREMIO_RESULT_MEMORY_CACHE_MAX_ENTRIES=200
STREMIO_RESULT_MEMORY_CACHE_MAX_MB=4
PROVIDER_RESULT_MEMORY_CACHE_MAX_ENTRIES=200
PROVIDER_RESULT_MEMORY_CACHE_MAX_MB=2
HUBCLOUD_MEMORY_CACHE_MAX_ENTRIES=100
HUBCLOUD_MEMORY_CACHE_MAX_MB=1
STREMIO_MAX_INFLIGHT_SEARCHES=35
MAX_ACTIVE_STREAMS=6
PROVIDER_GLOBAL_MAX_INFLIGHT=6

# Provider and stream timing/cache knobs. Defaults are usually fine.
PROVIDER_TIMEOUT_SECONDS=18
PROVIDER_CACHE_TTL_SECONDS=3600
STREMIO_RESULT_CACHE_TTL_SECONDS=3600
STREMIO_EMPTY_RESULT_CACHE_TTL_SECONDS=5

# Scrapling helper service. Autostart is local-only and may need Python deps.
SCRAPLING_SERVICE_URL=http://127.0.0.1:8787
SCRAPLING_SERVICE_TIMEOUT_MS=32000
SCRAPLING_SERVICE_AUTOSTART=true

# Torbox API keys are private per Stremio install URL, not server-wide env.
# Do not put user Torbox keys in this file.
TORBOX_WEBDL_READY_TIMEOUT_MS=25000
